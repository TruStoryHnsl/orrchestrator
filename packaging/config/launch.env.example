# orrchestrator launch parameters
#
# This file is sourced by ~/.local/bin/orrchestrator and orrchestrator-dev
# with `set -a`, so every uncommented `KEY=value` line becomes an environment
# variable for the app. All variables are optional — defaults documented in
# CLAUDE.md apply when a var is unset.
#
# To customize: copy this file to ~/.config/orrchestrator/launch.env (the
# installer does this automatically on first run) and uncomment the lines
# you want to override.

# ── WebUI: local HTTP listener ────────────────────────────────────────
# Always-on. Localhost connections bypass the auth token.
# ORRCH_WEBUI_PORT=8484
# ORRCH_WEBUI_BIND=127.0.0.1            # 0.0.0.0 to expose on LAN/tailnet

# ── WebUI: TLS listener (optional) ────────────────────────────────────
# Provide cert + key to enable HTTPS. To bind 443 without root:
#   sudo setcap cap_net_bind_service=+ep ./target/release/orrchestrator
# ORRCH_WEBUI_TLS_CERT=/etc/letsencrypt/live/orrchestrator.com/fullchain.pem
# ORRCH_WEBUI_TLS_KEY=/etc/letsencrypt/live/orrchestrator.com/privkey.pem
# ORRCH_WEBUI_TLS_PORT=8443
# ORRCH_WEBUI_TLS_BIND=0.0.0.0

# ── WebUI: secondary public HTTP (optional) ───────────────────────────
# Useful for serving orrchestrator.com on port 80 from the same process.
# ORRCH_WEBUI_PUBLIC_HTTP_PORT=80
# ORRCH_WEBUI_PUBLIC_HTTP_BIND=0.0.0.0
# ORRCH_WEBUI_PUBLIC_URL=http://orrchestrator.com

# ── WebUI: auth ───────────────────────────────────────────────────────
# ORRCH_WEBUI_TOKEN required for any non-loopback / non-trusted connection.
# Generate one with: openssl rand -hex 32
# ORRCH_WEBUI_TOKEN=
# Trusted CIDRs bypass the token. Default trusts loopback only.
# ORRCH_WEBUI_TRUSTED_CIDRS=100.64.0.0/10

# Dev-loop build performance. See chore/dev-build-perf.
#
# Two goals:
#   1. Keep the machine responsive during builds (don't pin all 8 cores).
#   2. Make incremental link steps fast (rust-lld linker is the slow part of
#      a debug rebuild on a multi-crate workspace).

[build]
# Cap codegen jobs so some cores stay free for the editor / running TUI
# while cargo-watch rebuilds. Tune to your core count; remove for fastest
# CI/release builds.
jobs = 6

[target.x86_64-unknown-linux-gnu]
# clang + mold: mold is the fastest linker available and dramatically beats
# the default GNU bfd ld on this multi-crate workspace's link step.
# Requires clang + mold on PATH. Copy this file to .cargo/config.toml to
# enable it locally; without it, cargo uses the default toolchain/linker.
# Fallback: if mold is ever missing, swap `-fuse-ld=mold` for `-fuse-ld=lld`.
linker = "clang"
rustflags = ["-C", "link-arg=-fuse-ld=mold"]
